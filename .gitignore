# --- Node / Frontend Caches ---
node_modules/
.npm
.eslintcache
web_ui/dist/
web_ui/node_modules/

# --- Python Caches & Environments ---
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt

# --- Environment & Key Files ---
.env
.env*.local
agent_server/.env

# --- Local Databases & Sessions Caches ---
agent_server/.sessions/cooldowns.json

# --- Sandbox: ALL generated project files are excluded from git ---
# Users' projects are stored locally only, never pushed to GitHub.
# The sandbox/ folder itself is tracked (via the .gitkeep below),
# but every subfolder and its contents are excluded.
sandbox/*
!sandbox/.gitkeep

# --- OS Caches & Logs ---
.DS_Store
Thumbs.db
*.log
*.tmp
*.pdf
