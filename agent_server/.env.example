# ─────────────────────────────────────────────────────────────────────────────
# Lovable Clone — Local Agent Configuration
# ─────────────────────────────────────────────────────────────────────────────
#
# QUICKSTART (Recommended):
# Set PROXY_URL to the Render cloud gateway URL.
# Your API keys are stored securely on Render — not here.
# Users never see the real keys.
#
# PROXY_URL=https://your-proxy-name.onrender.com
#
# ─────────────────────────────────────────────────────────────────────────────
# ADVANCED (Direct provider access — for local development only):
# If PROXY_URL is empty, the agent falls back to direct API key calls below.
# You need at least ONE key below for the agent to work in direct mode.
# ─────────────────────────────────────────────────────────────────────────────

# Cloud proxy URL (set this to hide your API keys from users)
PROXY_URL=

# Direct provider keys (only needed if PROXY_URL is not set above)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash

GEMINI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GITHUB_TOKEN=

# Ollama Endpoint (Only needed if LLM_PROVIDER=ollama)
OLLAMA_API_BASE=http://localhost:11434/v1
